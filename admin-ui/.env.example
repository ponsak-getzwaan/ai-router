# Copy to .env.local and fill in your values.
# Never commit .env.local.

# Cognito User Pool — get these from the AWS console or Terraform outputs.
VITE_COGNITO_DOMAIN=https://airouter-admin-dev.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_app_client_id_here
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/

# Admin API — Vite proxies /admin/* to this URL in dev.
# In production (CloudFront), same-origin so no proxy needed.
VITE_API_BASE_URL=http://localhost:8000
